{
  "name": "crowdfund",
  "version": "2.0.0",
  "description": "Internet Computer canister for crowdfunding campaigns with ICRC-1/ICRC-2 token settlement, written in TypeScript with Azle.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "dfx start --background",
    "start:clean": "dfx start --background --clean",
    "build": "dfx build",
    "deploy": "dfx deploy",
    "stop": "dfx stop",
    "test:e2e": "bash test/e2e.sh",
    "deploy:local": "bash scripts/deploy-local.sh",
    "setup:local": "bash scripts/setup-local-canisters.sh",
    "test:concurrency": "bash test/concurrency.sh"
  },
  "dependencies": {
    "azle": "^0.33.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
