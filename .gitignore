# Various IDEs and Editors
.vscode/
.idea/
**/*~

# Mac OSX temporary files
.DS_Store
**/.DS_Store

# dfx temporary files
.dfx/

# generated files
# NOTE: src/declarations/ is deliberately NOT ignored. The frontend imports the
# Candid bindings statically, so builds that have no dfx — the static demo, and
# its Pages workflow — cannot generate them. CI regenerates and diffs them, so
# committing them cannot go stale silently.

# frontend code
node_modules/
dist/

# environment variables
.env
.azle

# downloaded third-party canisters (ledger, internet identity)
.local-canisters/

# frontend build output
frontend/dist/

# typescript incremental build cache
*.tsbuildinfo
